{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal-proof-spec.schema.json",
  "title": "QuickMaths Lesson Formal Proof Specification",
  "description": "Opt-in declarative lesson metadata. This is not a proof certificate and does not enable production grading by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "statement"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal"
      ],
      "properties": {
        "declarations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "parameter_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_public": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "allowed_rules": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "description": "Optional curated loading guidance. This metadata does not enable browser certification or change the proof rule contract.",
      "items": {
        "type": "string",
        "enum": ["algebra", "limits", "derivatives", "sequences-series", "radicals"]
      }
    },
    "assessment_policy": {
      "type": "object"
    },
    "reference_proof": {
      "type": [
        "object",
        "array"
      ],
      "description": "Author reference proof candidate. Empty means no checked reference proof is supplied.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "steps",
                "auto",
                "author_candidate"
              ]
            },
            "steps": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/referenceStep"
              }
            }
          }
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/referenceStep"
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "toolchain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "library": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "library_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "$defs": {
    "referenceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "rule"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "premises": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
