+    wasmEnvCache.modify (·.push (key, env))
+    IO.eprintln s!"[WASM DEBUG] wasmLoadSnapshot: cached env for {reprStr key}"
+    return 0
+  catch e =>
+    IO.eprintln s!"[WASM DEBUG] wasmLoadSnapshot failed: {e}"
+    return 1
